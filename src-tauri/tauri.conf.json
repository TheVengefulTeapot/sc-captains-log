{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SC Captains Log",
  "version": "1.1.0",
  "identifier": "com.sc.captainslog",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "The Vengeful Teapot",
    "copyright": "The Vengeful Teapot",
    "shortDescription": "SC Captain's Log",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
